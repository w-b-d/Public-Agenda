# Supabase project URL and publishable (anon) key.
# Get these from: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Colab/ngrok URL hosting the Whisper + Qwen FastAPI server (no trailing slash).
# e.g. https://treason-anaconda-impure.ngrok-free.dev
EXPO_PUBLIC_COLAB_URL=
