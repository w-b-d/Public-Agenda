# Copy to .env and fill in. Never commit .env.
# Used by the local client scripts: main.py, populate_db.py, resummarize.py.

# Public base URL of the transcription server (notebooks/hackathon.ipynb),
# i.e. the ngrok URL it prints on startup. No trailing slash needed.
COLAB_URL=

# Supabase project URL. Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=

# Supabase secret (service-role) key. Bypasses row-level security, so keep it
# server-side only and never put it in the mobile app.
SUPABASE_SECRET_KEY=

# NGROK_AUTH_TOKEN is NOT read from this file. The notebooks and
# colab_server.py read it from Colab Secrets (key icon in the Colab sidebar)
# via google.colab.userdata.
